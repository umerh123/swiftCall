<footer class="gl-footer">
  <div class="gl-wrap gl-footer__top">
    <div>
      <div class="gl-footer__brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 80 }}" width="40" height="40" alt="{{ shop.name }}">
        {%- else -%}
          {{ 'gl-logo.svg' | asset_url | img_tag: shop.name }}
        {%- endif -%}
        <span class="gl-footer__brand-name gl-display">{{ shop.name }}<span class="gl-dot">.</span></span>
      </div>
      <p class="gl-footer__tag">{{ section.settings.tagline }}</p>
    </div>

    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign col_title = section.settings.col1_title
            assign col_menu = section.settings.col1_menu
          when 2
            assign col_title = section.settings.col2_title
            assign col_menu = section.settings.col2_menu
          when 3
            assign col_title = section.settings.col3_title
            assign col_menu = section.settings.col3_menu
        endcase
      -%}
      <div>
        <h4>{{ col_title }}</h4>
        <div class="gl-footer__links">
          {%- if col_menu != blank and col_menu.links.size > 0 -%}
            {%- for link in col_menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            {%- render 'footer-links-fallback', column: i -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="gl-footer__bottom">
    <div class="gl-wrap gl-footer__bottom-row">
      <p>© {{ 'now' | date: "%Y" }} {{ shop.name }} · All rights reserved.</p>
      <p class="is-caps">{{ section.settings.payment_text }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Los Angeles streetwear. New drops weekly. Built in Downtown LA." },
    { "type": "text", "id": "col1_title", "label": "Column 1 title", "default": "Shop" },
    { "type": "link_list", "id": "col1_menu", "label": "Column 1 menu" },
    { "type": "text", "id": "col2_title", "label": "Column 2 title", "default": "Help" },
    { "type": "link_list", "id": "col2_menu", "label": "Column 2 menu" },
    { "type": "text", "id": "col3_title", "label": "Column 3 title", "default": "Company" },
    { "type": "link_list", "id": "col3_menu", "label": "Column 3 menu" },
    { "type": "text", "id": "payment_text", "label": "Payment text", "default": "Klarna · Afterpay · Shop Pay · PayPal" }
  ]
}
{% endschema %}
