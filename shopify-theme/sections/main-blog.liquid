{%- paginate blog.articles by 12 -%}
  <div class="gl-wrap gl-page">
    <h1 class="gl-display">{{ blog.title }}</h1>
    <div class="gl-blog-grid" style="margin-top:2rem;">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="gl-blog-card">
          <div class="gl-blog-card__media">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy">
            {%- else -%}
              {{ 'article' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="gl-blog-card__date">{{ article.published_at | date: "%B %d, %Y" }}</div>
          <h2>{{ article.title }}</h2>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="gl-pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{% render 'icon', name: 'chevron-left' %}</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="is-current">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{% render 'icon', name: 'chevron-right' %}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog page",
  "settings": []
}
{% endschema %}
