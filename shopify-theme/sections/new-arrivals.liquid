{%- liquid
  assign demo_images = 'gl-hero-1.jpg,gl-cat-jeans.jpg,gl-hero-2.jpg,gl-hero-3.jpg' | split: ','
  assign collection = section.settings.collection
-%}
<section class="gl-section">
  <div class="gl-wrap">
    <div class="gl-section-head">
      <div>
        <div class="gl-eyebrow">{{ section.settings.eyebrow }}</div>
        <h2 class="gl-display">{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ section.settings.cta_url }}" class="gl-section-cta">
        {{ section.settings.cta_label }} {% render 'icon', name: 'arrow-right' %}
      </a>
    </div>

    <div class="gl-grid-2">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: 4 -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign fallback_idx = forloop.index0 | modulo: demo_images.size
          -%}
          <div {{ block.shopify_attributes }}>
            {%- render 'product-card',
              demo_image: block.settings.image,
              demo_fallback_image: demo_images[fallback_idx],
              demo_name: block.settings.name,
              demo_price: block.settings.price,
              demo_tag: block.settings.tag,
              demo_url: block.settings.url
            -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New arrivals",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fresh · Week 34" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Shop All New" },
    { "type": "url", "id": "cta_url", "label": "Link url", "default": "/collections/just-dropped" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "When set, shows real products from this collection instead of the placeholder demo cards below."
    }
  ],
  "blocks": [
    {
      "type": "demo_product",
      "name": "Demo product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Product name" },
        { "type": "text", "id": "price", "label": "Price (number only)", "default": "34" },
        {
          "type": "select",
          "id": "tag",
          "label": "Tag",
          "options": [
            { "value": "", "label": "None" },
            { "value": "New", "label": "New" },
            { "value": "Restock", "label": "Restock" },
            { "value": "Best", "label": "Best" },
            { "value": "Last Piece", "label": "Last Piece" }
          ],
          "default": "New"
        },
        { "type": "url", "id": "url", "label": "Link", "default": "/collections/just-dropped" }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "demo_product", "settings": { "name": "Angel Wash Graphic Tee", "price": "34", "tag": "New", "url": "/collections/just-dropped" } },
      { "type": "demo_product", "settings": { "name": "Vintage Wash Stacked Denim", "price": "89", "tag": "New", "url": "/collections/baggy-jeans" } },
      { "type": "demo_product", "settings": { "name": "Cropped Boxy Hoodie — Bone", "price": "68", "tag": "Restock", "url": "/collections/hoodies" } },
      { "type": "demo_product", "settings": { "name": "Palm Print Oversized Tee", "price": "38", "tag": "New", "url": "/collections/just-dropped" } }
    ]
  }
}
{% endschema %}
