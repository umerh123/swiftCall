{%- comment -%}
  Renders one product tile. Pass either:
  - product: a real Shopify product object
  - demo_image / demo_name / demo_price / demo_tag / demo_url: static placeholder content
{%- endcomment -%}
{%- if product -%}
  {%- liquid
    assign card_url = product.url
    assign card_name = product.title
    assign card_image = product.featured_media.preview_image | default: product.featured_image
    assign card_price = product.price | money
    assign compare_price = product.compare_at_price
    assign on_sale = false
    if compare_price > product.price
      assign on_sale = true
    endif
    assign variant_id = product.selected_or_first_available_variant.id
  -%}
  <div class="gl-card">
    <a href="{{ card_url }}" class="gl-card__link">
      <div class="gl-card__media">
        {%- if card_image -%}
          <img src="{{ card_image | image_url: width: 800 }}" alt="{{ card_name | escape }}" loading="lazy" width="800" height="1000">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if product.available == false -%}
          <span class="gl-card__tag is-dark">Sold Out</span>
        {%- elsif on_sale -%}
          <span class="gl-card__tag">Sale</span>
        {%- endif -%}
        <button type="button" class="gl-card__wish" aria-label="Add to wishlist" onclick="event.preventDefault()">
          {% render 'icon', name: 'heart' %}
        </button>
      </div>
    </a>
    <div class="gl-card__add">
      <form action="/cart/add" method="post" enctype="multipart/form-data" data-gl-quick-add>
        <input type="hidden" name="id" value="{{ variant_id }}">
        <button type="submit" {% if product.available == false %}disabled{% endif %}>
          {% if product.available == false %}Sold Out{% else %}Quick Add{% endif %}
        </button>
      </form>
    </div>
    <a href="{{ card_url }}" class="gl-card__meta-link">
      <div class="gl-card__meta">
        <h3 class="gl-card__name">{{ card_name }}</h3>
        <div class="gl-card__price">
          {%- if on_sale -%}<s>{{ compare_price | money }}</s>{%- endif -%}
          {{ card_price }}
        </div>
      </div>
    </a>
  </div>
{%- else -%}
  <a href="{{ demo_url | default: '#' }}" class="gl-card">
    <div class="gl-card__media">
      {%- if demo_image != blank -%}
        <img src="{{ demo_image | image_url: width: 800 }}" alt="{{ demo_name | escape }}" loading="lazy" width="800" height="1000">
      {%- else -%}
        <img src="{{ demo_fallback_image | asset_url }}" alt="{{ demo_name | escape }}" loading="lazy" width="800" height="1000">
      {%- endif -%}
      {%- if demo_tag != blank -%}
        <span class="gl-card__tag{% if demo_tag == 'Last Piece' %} is-dark{% endif %}">{{ demo_tag }}</span>
      {%- endif -%}
      <button type="button" class="gl-card__wish" aria-label="Add to wishlist" onclick="event.preventDefault()">
        {% render 'icon', name: 'heart' %}
      </button>
    </div>
    <div class="gl-card__meta">
      <h3 class="gl-card__name">{{ demo_name }}</h3>
      <div class="gl-card__price">${{ demo_price }}</div>
    </div>
  </a>
{%- endif -%}
