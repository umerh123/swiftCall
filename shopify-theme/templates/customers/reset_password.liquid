<div class="gl-wrap gl-page" style="max-width:28rem;">
  <h1 class="gl-display">Reset Password</h1>
  {%- form 'reset_customer_password', style: 'margin-top:2rem;' -%}
    {%- if form.errors -%}
      <p style="color:#b00020; margin-bottom:1rem;">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="gl-product__option">
      <label for="ResetPassword">New password</label>
      <input type="password" name="customer[password]" id="ResetPassword" required style="width:100%; padding:0.875rem 1rem; border:1px solid var(--border);">
    </div>
    <div class="gl-product__option">
      <label for="ResetPasswordConfirm">Confirm new password</label>
      <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" required style="width:100%; padding:0.875rem 1rem; border:1px solid var(--border);">
    </div>
    <button type="submit" class="gl-btn gl-btn--black" style="justify-content:center; width:100%;">Reset Password</button>
  {%- endform -%}
</div>
